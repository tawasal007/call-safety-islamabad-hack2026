# For the local LiveKit server in development mode only.
# Replace all three values with your LiveKit Cloud project credentials later.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Required locally and on Vercel. Generate a fresh value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=replace-with-a-random-64-character-hex-value

# Optional browser-facing URL when the LiveKit endpoint differs from LIVEKIT_URL.
# Needed for a second device if the app/server addresses differ.
# LIVEKIT_PUBLIC_URL=wss://your-livekit-project.livekit.cloud

# Persistent Python caption service. Never use NEXT_PUBLIC_ for these values.
TRANSCRIPTION_WORKER_URL=http://127.0.0.1:8001
TRANSCRIPTION_WORKER_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Streaming English/Urdu uses LiveKit Cloud Inference and existing server credentials.
# Local LiveKit servers need both STT backends=whisper and TEXT_TRANSLATION_BACKEND=local.
ENGLISH_STT_BACKEND=livekit
URDU_STT_BACKEND=livekit
LIVEKIT_STT_MODEL=deepgram/nova-3
# Fast bidirectional text translation follows final captions through LiveKit/Google.
# Set local to use NLLB on this laptop, or disabled to omit translations.
TEXT_TRANSLATION_BACKEND=livekit
LIVEKIT_TRANSLATION_MODEL=google/gemini-3.1-flash-lite
# Worker inference defaults are for CPU development. Benchmark medium/large-v3
# on a GPU for Urdu accuracy and faster inference.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
URDU_TRANSLATION_BACKEND=local
