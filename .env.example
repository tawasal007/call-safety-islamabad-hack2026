# For the local LiveKit server in development mode only.
# Replace all three values with your LiveKit Cloud project credentials later.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Required locally and on Vercel. Generate a fresh value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=replace-with-a-random-64-character-hex-value

# Optional browser-facing URL when the LiveKit endpoint differs from LIVEKIT_URL.
# Needed for a second device if the app/server addresses differ.
# LIVEKIT_PUBLIC_URL=wss://your-livekit-project.livekit.cloud
